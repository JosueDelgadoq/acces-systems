APP_NAME="ERP Access Systems"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SAMU_WEBHOOK_SECRET=token_seguro_para_webhook
SAMU_API_KEY=api_key_de_samu

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ALERT_FALLBACK_EMAILS=
ALERT_FALLBACK_WHATSAPP=
ALERT_PENDING_DUE_ENABLED=true
ALERT_PENDING_DUE_INCLUDE_ASSIGNED_USER_EMAIL=true
ALERT_PENDING_DUE_INCLUDE_ASSIGNED_USER_WHATSAPP=true
ALERT_PENDING_DUE_INCLUDE_CLIENT_EMAIL=false
ALERT_PENDING_DUE_INCLUDE_CLIENT_WHATSAPP=false
ALERT_PENDING_DUE_SEND_DATABASE_NOTIFICATION=true
ALERT_PENDING_LIFECYCLE_ENABLED=true
ALERT_PENDING_LIFECYCLE_INCLUDE_ASSIGNED_USER_EMAIL=true
ALERT_PENDING_LIFECYCLE_INCLUDE_PREVIOUS_ASSIGNED_USER_EMAIL=true
ALERT_PENDING_LIFECYCLE_INCLUDE_CLIENT_EMAIL=false
ALERT_PENDING_LIFECYCLE_SEND_DATABASE_NOTIFICATION=true
ALERT_COMMERCIAL_ENABLED=true
ALERT_COMMERCIAL_INCLUDE_COMMERCIAL_EMAIL=true
ALERT_COMMERCIAL_INCLUDE_MANAGEMENT_EMAIL=true
ALERT_COMMERCIAL_STALE_DAYS=3
ALERT_COMMERCIAL_GOAL_PROGRESS_TOLERANCE=15
WHATSAPP_DRIVER=log
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
